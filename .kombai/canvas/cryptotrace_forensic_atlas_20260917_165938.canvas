      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Roboto+Mono:wght@400;500;600&display=swap');\n  :root { color-scheme: dark; }\n  .atlas-scroll::-webkit-scrollbar { width: 8px; height: 8px; }\n  .atlas-scroll::-webkit-scrollbar-thumb { background: #263342; border-radius: 999px; }\n  .atlas-scroll::-webkit-scrollbar-track { background: #0b0f14; }\n  .thin-scroll::-webkit-scrollbar { height: 6px; }\n  .thin-scroll::-webkit-scrollbar-thumb { background: #33465a; border-radius: 999px; }\n  .svg-label { font-family: 'Inter', sans-serif; fill: #d7dee8; }\n  .svg-mono { font-family: 'Roboto Mono', monospace; fill: #9eabb9; }\n  .svg-muted { font-family: 'Inter', sans-serif; fill: #8895a7; }\n  .svg-node { cursor: default; }\n</style>\n<div class=\"min-h-[1940px] bg-[#0b0f14] text-[#d7dee8] [font-family:Inter,ui-sans-serif,system-ui,sans-serif]\" data-kid=\"1\" data-name=\"page layout container\" style=\"--bg:#0b0f14;--sidebar:#090d12;--panel:#121922;--panel2:#17212d;--line:#263342;--muted:#8895a7;--text:#d7dee8;--blue:#5da9ff;--green:#55d28a;--amber:#f5b84b;--red:#f87171;--yellow:#f7d154;--purple:#b695ff;\">\n    <div class=\"grid min-h-[1940px] grid-cols-[248px_minmax(0,1fr)]\" data-kid=\"1-1\" data-name=\"grid layout container\">\n        <aside class=\"border-r border-[#263342] bg-[#090d12] px-4 py-5\" data-kid=\"1-1-1\" data-name=\"sidebar container\">\n            <div class=\"flex items-center gap-3 border-b border-[#263342] px-2 pb-5\" data-kid=\"1-1-1-1\" data-name=\"sidebar header container\">\n                <div class=\"grid h-10 w-10 shrink-0 place-items-center border border-[#42617e] bg-[#102131] text-sm font-extrabold text-[#9fd0ff]\" data-kid=\"1-1-1-1-1\" data-name=\"product logo placeholder\">\n                    CT\n                </div>\n                <div data-kid=\"1-1-1-1-2\" data-name=\"product title and identifier container\">\n                    <div class=\"text-[15px] font-bold leading-tight text-[#f2f6fb]\" data-kid=\"1-1-1-1-2-1\" data-name=\"product title text\">\n                        CryptoTrace\n                        <br data-kid=\"1-1-1-1-2-1-1\" data-name=\"line break\"/>\n                        LEA\n                    </div>\n                    <div class=\"mt-1 text-[11px] text-[#8895a7]\" data-kid=\"1-1-1-1-2-2\" data-name=\"session identifier text\">\n                        SIH 26183 · field console\n                    </div>\n                </div>\n            </div>\n            <div class=\"atlas-scroll mt-5 space-y-6\" data-kid=\"1-1-1-2\" data-name=\"sidebar navigation menu container\">\n                <div data-kid=\"1-1-1-2-1\" data-name=\"casework navigation group\">\n                    <div class=\"mb-2 px-2 text-[10px] font-semibold uppercase tracking-[0.16em] text-[#68778a]\" data-kid=\"1-1-1-2-1-1\" data-name=\"casework group title\">\n                        Casework\n                    </div>\n                    <div class=\"space-y-1\" data-kid=\"1-1-1-2-1-2\" data-name=\"casework navigation list\">\n                        <button class=\"flex min-h-10 w-full items-center justify-between border-l-2 border-transparent px-3 text-left text-sm text-[#aab5c3] hover:bg-[#101923]\" data-kid=\"1-1-1-2-1-2-1\" data-name=\"overview navigation item\">\n                            <span data-kid=\"1-1-1-2-1-2-1-1\" data-name=\"overview label\">\n                                Overview\n                            </span>\n                            <span class=\"font-mono text-[10px] text-[#68778a]\" data-kid=\"1-1-1-2-1-2-1-2\" data-name=\"overview counter\">\n                                01\n                            </span>\n                        </button>\n                        <button class=\"flex min-h-10 w-full items-center justify-between border-l-2 border-transparent px-3 text-left text-sm text-[#aab5c3] hover:bg-[#101923]\" data-kid=\"1-1-1-2-1-2-2\" data-name=\"cases navigation item\">\n                            <span data-kid=\"1-1-1-2-1-2-2-1\" data-name=\"cases label\">\n                                Cases\n                            </span>\n                            <span class=\"font-mono text-[10px] text-[#68778a]\" data-kid=\"1-1-1-2-1-2-2-2\" data-name=\"cases counter\">\n                                01\n                            </span>\n                        </button>\n                        <button class=\"flex min-h-10 w-full items-center justify-between border-l-2 border-transparent px-3 text-left text-sm text-[#aab5c3] hover:bg-[#101923]\" data-kid=\"1-1-1-2-1-2-3\" data-name=\"alerts navigation item\">\n                            <span data-kid=\"1-1-1-2-1-2-3-1\" data-name=\"alerts label\">\n                                Alerts\n                            </span>\n                            <span class=\"rounded-full border border-[#75333a] bg-[#2b1115] px-2 py-0.5 font-mono text-[10px] text-[#f87171]\" data-kid=\"1-1-1-2-1-2-3-2\" data-name=\"alerts counter badge\">\n                                22\n                            </span>\n                        </button>\n                    </div>\n                </div>\n                <div data-kid=\"1-1-1-2-2\" data-name=\"trace analysis navigation group\">\n                    <div class=\"mb-2 px-2 text-[10px] font-semibold uppercase tracking-[0.16em] text-[#68778a]\" data-kid=\"1-1-1-2-2-1\" data-name=\"trace analysis group title\">\n                        Trace and analysis\n                    </div>\n                    <div class=\"space-y-1\" data-kid=\"1-1-1-2-2-2\" data-name=\"trace analysis navigation list\">\n                        <button class=\"flex min-h-10 w-full items-center justify-between border-l-2 border-[#5da9ff] bg-[#152131] px-3 text-left text-sm font-semibold text-white\" data-kid=\"1-1-1-2-2-2-1\" data-name=\"investigations navigation item\">\n                            <span data-kid=\"1-1-1-2-2-2-1-1\" data-name=\"investigations label\">\n                                Investigations\n                            </span>\n                            <span class=\"font-mono text-[10px] text-[#8ca9c7]\" data-kid=\"1-1-1-2-2-2-1-2\" data-name=\"investigations active indicator\">\n                                ACTIVE\n                            </span>\n                        </button>\n                        <button class=\"flex min-h-10 w-full items-center px-3 text-left text-sm text-[#aab5c3] hover:bg-[#101923]\" data-kid=\"1-1-1-2-2-2-2\" data-name=\"transactions navigation item\">\n                            Transactions\n                        </button>\n                        <button class=\"flex min-h-10 w-full items-center px-3 text-left text-sm text-[#aab5c3] hover:bg-[#101923]\" data-kid=\"1-1-1-2-2-2-3\" data-name=\"wallets navigation item\">\n                            Wallets\n                        </button>\n                        <button class=\"flex min-h-10 w-full items-center px-3 text-left text-sm text-[#aab5c3] hover:bg-[#101923]\" data-kid=\"1-1-1-2-2-2-4\" data-name=\"typologies navigation item\">\n                            Typologies\n                        </button>\n                        <button class=\"flex min-h-10 w-full items-center justify-between px-3 text-left text-sm text-[#aab5c3] hover:bg-[#101923]\" data-kid=\"1-1-1-2-2-2-5\" data-name=\"vasp intelligence navigation item\">\n                            <span data-kid=\"1-1-1-2-2-2-5-1\" data-name=\"vasp intelligence label\">\n                                VASP Intelligence\n                            </span>\n                            <span class=\"font-mono text-[10px] text-[#68778a]\" data-kid=\"1-1-1-2-2-2-5-2\" data-name=\"vasp intelligence counter\">\n                                03\n                            </span>\n                        </button>\n                        <button class=\"flex min-h-10 w-full items-center px-3 text-left text-sm text-[#aab5c3] hover:bg-[#101923]\" data-kid=\"1-1-1-2-2-2-6\" data-name=\"cross-chain navigation item\">\n                            Cross-Chain\n                        </button>\n                    </div>\n                </div>\n                <div data-kid=\"1-1-1-2-3\" data-name=\"records navigation group\">\n                    <div class=\"mb-2 px-2 text-[10px] font-semibold uppercase tracking-[0.16em] text-[#68778a]\" data-kid=\"1-1-1-2-3-1\" data-name=\"records group title\">\n                        Records\n                    </div>\n                    <div class=\"space-y-1\" data-kid=\"1-1-1-2-3-2\" data-name=\"records navigation list\">\n                        <button class=\"flex min-h-10 w-full items-center px-3 text-left text-sm text-[#aab5c3] hover:bg-[#101923]\" data-kid=\"1-1-1-2-3-2-1\" data-name=\"evidence navigation item\">\n                            Evidence\n                        </button>\n                        <button class=\"flex min-h-10 w-full items-center px-3 text-left text-sm text-[#aab5c3] hover:bg-[#101923]\" data-kid=\"1-1-1-2-3-2-2\" data-name=\"reports navigation item\">\n                            Reports\n                        </button>\n                    </div>\n                </div>\n                <div data-kid=\"1-1-1-2-4\" data-name=\"oversight navigation group\">\n                    <div class=\"mb-2 px-2 text-[10px] font-semibold uppercase tracking-[0.16em] text-[#68778a]\" data-kid=\"1-1-1-2-4-1\" data-name=\"oversight group title\">\n                        Oversight\n                    </div>\n                    <div class=\"space-y-1\" data-kid=\"1-1-1-2-4-2\" data-name=\"oversight navigation list\">\n                        <button class=\"flex min-h-10 w-full items-center justify-between px-3 text-left text-sm text-[#aab5c3] hover:bg-[#101923]\" data-kid=\"1-1-1-2-4-2-1\" data-name=\"supervisor navigation item\">\n                            <span data-kid=\"1-1-1-2-4-2-1-1\" data-name=\"supervisor label\">\n                                Supervisor\n                            </span>\n                            <span class=\"h-2 w-2 rounded-full bg-[#55d28a]\" data-kid=\"1-1-1-2-4-2-1-2\" data-name=\"supervisor status indicator\">\n                            </span>\n                        </button>\n                        <button class=\"flex min-h-10 w-full items-center px-3 text-left text-sm text-[#aab5c3] hover:bg-[#101923]\" data-kid=\"1-1-1-2-4-2-2\" data-name=\"system status navigation item\">\n                            System Status\n                        </button>\n                    </div>\n                </div>\n            </div>\n            <div class=\"mt-8 border-t border-[#263342] px-2 pt-4 text-[11px] leading-5 text-[#68778a]\" data-kid=\"1-1-1-3\" data-name=\"sidebar footer\">\n                Evidence-first workspace\n                <br data-kid=\"1-1-1-3-1\" data-name=\"line break\"/>\n                <span class=\"font-mono text-[#8895a7]\" data-kid=\"1-1-1-3-2\" data-name=\"version information text\">\n                    v0.1 · fixture boundary\n                </span>\n            </div>\n        </aside>\n        <main class=\"min-w-0 bg-[#0b0f14] px-6 py-5\" data-kid=\"1-1-2\" data-name=\"main content area\">\n            <div class=\"flex items-start justify-between gap-5 border-b border-[#263342] pb-4\" data-kid=\"1-1-2-1\" data-name=\"workspace header\">\n                <div data-kid=\"1-1-2-1-1\" data-name=\"header title group\">\n                    <div class=\"mb-1 text-[10px] font-semibold uppercase tracking-[0.16em] text-[#8895a7]\" data-kid=\"1-1-2-1-1-1\" data-name=\"header subtitle text\">\n                        Investigator workstation\n                    </div>\n                    <div class=\"flex items-baseline gap-4\" data-kid=\"1-1-2-1-1-2\" data-name=\"header title container\">\n                        <h1 class=\"m-0 text-[25px] font-bold tracking-[-0.02em] text-[#f2f6fb]\" data-kid=\"1-1-2-1-1-2-1\" data-name=\"header title text\">\n                            Investigations\n                        </h1>\n                        <span class=\"font-mono text-[11px] text-[#68778a]\" data-kid=\"1-1-2-1-1-2-2\" data-name=\"case context breadcrumb\">\n                            CASE VIEW · TRACE 01\n                        </span>\n                    </div>\n                </div>\n                <div class=\"flex items-center gap-2\" data-kid=\"1-1-2-1-2\" data-name=\"header controls group\">\n                    <span class=\"rounded-full border border-[#6d5515] bg-[#221a05] px-3 py-1.5 text-[10px] font-bold uppercase tracking-wide text-[#f7d154]\" data-kid=\"1-1-2-1-2-1\" data-name=\"replay mode indicator\">\n                        FIXTURE REPLAY\n                    </span>\n                    <span class=\"rounded-full border border-[#6d5515] bg-[#221a05] px-3 py-1.5 text-[10px] font-bold uppercase tracking-wide text-[#f7d154]\" data-kid=\"1-1-2-1-2-2\" data-name=\"demo data indicator\">\n                        DEMO DATA\n                    </span>\n                    <span class=\"border border-[#263342] bg-[#101820] px-3 py-2 font-mono text-[12px] text-[#d7dee8]\" data-kid=\"1-1-2-1-2-3\" data-name=\"case identifier\">\n                        CASE-2026-184721\n                    </span>\n                    <button class=\"border border-[#315c8f] bg-[#102131] px-3 py-2 text-[12px] text-[#eaf5ff]\" data-kid=\"1-1-2-1-2-4\" data-name=\"role selector button\">\n                        Role: INVESTIGATOR\n                        <span class=\"ml-1 text-[#5da9ff]\" data-kid=\"1-1-2-1-2-4-1\" data-name=\"dropdown arrow\">\n                            ⌄\n                        </span>\n                    </button>\n                </div>\n            </div>\n            <section class=\"mt-4 border-y border-[#31516d] bg-[#101a25] px-4 py-3\" data-kid=\"1-1-2-2\" data-name=\"case summary ribbon\">\n                <div class=\"flex items-center justify-between gap-4\" data-kid=\"1-1-2-2-1\" data-name=\"summary metrics container\">\n                    <div class=\"flex min-w-0 items-center gap-4\" data-kid=\"1-1-2-2-1-1\" data-name=\"case meta info container\">\n                        <div data-kid=\"1-1-2-2-1-1-1\" data-name=\"case id container\">\n                            <div class=\"text-[10px] uppercase tracking-[0.12em] text-[#8895a7]\" data-kid=\"1-1-2-2-1-1-1-1\" data-name=\"case id label\">\n                                Active case\n                            </div>\n                            <div class=\"mt-1 font-mono text-[13px] font-semibold text-[#f2f6fb]\" data-kid=\"1-1-2-2-1-1-1-2\" data-name=\"case id value\">\n                                CASE-2026-184721\n                            </div>\n                        </div>\n                        <div class=\"h-8 w-px bg-[#263342]\" data-kid=\"1-1-2-2-1-1-2\" data-name=\"vertical separator\">\n                        </div>\n                        <div data-kid=\"1-1-2-2-1-1-3\" data-name=\"fraud type container\">\n                            <div class=\"text-[10px] uppercase tracking-[0.12em] text-[#8895a7]\" data-kid=\"1-1-2-2-1-1-3-1\" data-name=\"fraud type label\">\n                                Fraud type\n                            </div>\n                            <div class=\"mt-1 text-[13px] font-semibold text-[#d7dee8]\" data-kid=\"1-1-2-2-1-1-3-2\" data-name=\"fraud type value\">\n                                INVESTMENT_FRAUD\n                            </div>\n                        </div>\n                        <span class=\"rounded-full border border-[#315c8f] bg-[#0b1a2a] px-2.5 py-1 text-[10px] font-bold text-[#5da9ff]\" data-kid=\"1-1-2-2-1-1-4\" data-name=\"ncrp badge\">\n                            NCRP\n                        </span>\n                        <span class=\"rounded-full border border-[#704f1d] bg-[#241907] px-2.5 py-1 text-[10px] font-bold text-[#f5b84b]\" data-kid=\"1-1-2-2-1-1-5\" data-name=\"partial coverage badge\">\n                            PARTIAL\n                        </span>\n                        <span class=\"text-[13px] text-[#a8b2bf]\" data-kid=\"1-1-2-2-1-1-6\" data-name=\"asset summary text\">\n                            Ethereum · ₹2,00,000\n                        </span>\n                    </div>\n                    <div class=\"flex shrink-0 items-center gap-2\" data-kid=\"1-1-2-2-1-2\" data-name=\"wallet actions container\">\n                        <span class=\"text-[10px] uppercase tracking-[0.12em] text-[#8895a7]\" data-kid=\"1-1-2-2-1-2-1\" data-name=\"reported wallet label\">\n                            Reported wallet\n                        </span>\n                        <span class=\"font-mono text-[12px] text-[#a8cfff]\" data-kid=\"1-1-2-2-1-2-2\" data-name=\"reported wallet address\">\n                            0x7F31...A92C\n                        </span>\n                        <button class=\"min-h-8 border border-[#263342] bg-[#0b1118] px-2 text-[11px] text-[#9fd0ff]\" data-kid=\"1-1-2-2-1-2-3\" data-name=\"copy button\">\n                            Copy\n                        </button>\n                    </div>\n                </div>\n            </section>\n            <div class=\"mt-3 flex items-center gap-3 border border-[#59491e] bg-[#171407] px-4 py-2.5 text-[12px] text-[#cdbf90]\" data-kid=\"1-1-2-3\" data-name=\"fixture warning banner\">\n                <strong class=\"shrink-0 text-[11px] font-bold uppercase tracking-wide text-[#f7d154]\" data-kid=\"1-1-2-3-1\" data-name=\"warning banner heading\">\n                    FIXTURE REPLAY · DEMO DATA\n                </strong>\n                <span data-kid=\"1-1-2-3-2\" data-name=\"warning banner text\">\n                    All intelligence is synthetic fixture-backed output. It is not live blockchain, NCRP, SAHYOG, VASP, legal, ownership, or recovery proof.\n                </span>\n            </div>\n            <section class=\"mt-4 grid grid-cols-[300px_minmax(0,1fr)_340px] items-start gap-3\" data-kid=\"1-1-2-4\" data-name=\"main investigation layout\">\n                <aside class=\"border border-[#263342] bg-[#121922]\" data-kid=\"1-1-2-4-1\" data-name=\"trace scope sidebar\">\n                    <div class=\"flex items-start justify-between border-b border-[#263342] px-4 py-3\" data-kid=\"1-1-2-4-1-1\" data-name=\"trace scope header\">\n                        <div data-kid=\"1-1-2-4-1-1-1\" data-name=\"trace scope title group\">\n                            <h2 class=\"m-0 text-[15px] font-bold text-[#f2f6fb]\" data-kid=\"1-1-2-4-1-1-1-1\" data-name=\"trace scope title\">\n                                Trace scope\n                            </h2>\n                            <p class=\"m-1 0 0 text-[11px] text-[#8895a7]\" data-kid=\"1-1-2-4-1-1-1-2\" data-name=\"trace scope description\">\n                                Bounded investigation controls\n                            </p>\n                        </div>\n                        <span class=\"rounded-full border border-[#2b704b] bg-[#0c2418] px-2 py-1 text-[10px] font-bold text-[#55d28a]\" data-kid=\"1-1-2-4-1-1-2\" data-name=\"status badge\">\n                            READY\n                        </span>\n                    </div>\n                    <div class=\"space-y-3 px-4 py-4\" data-kid=\"1-1-2-4-1-2\" data-name=\"trace settings form\">\n                        <div class=\"grid grid-cols-2 gap-2\" data-kid=\"1-1-2-4-1-2-1\" data-name=\"settings grid\">\n                            <label class=\"text-[11px] text-[#a8b2bf]\" data-kid=\"1-1-2-4-1-2-1-1\" data-name=\"max hops setting container\">\n                                Max hops\n                                <input class=\"mt-1 h-9 w-full border border-[#263342] bg-[#0b1118] px-2.5 font-mono text-[12px] text-[#d7dee8] outline-none\" data-kid=\"1-1-2-4-1-2-1-1-1\" data-name=\"max hops input\" readonly=\"\" value=\"5\"/>\n                            </label>\n                            <label class=\"text-[11px] text-[#a8b2bf]\" data-kid=\"1-1-2-4-1-2-1-2\" data-name=\"window hours setting container\">\n                                Window hours\n                                <input class=\"mt-1 h-9 w-full border border-[#263342] bg-[#0b1118] px-2.5 font-mono text-[12px] text-[#d7dee8] outline-none\" data-kid=\"1-1-2-4-1-2-1-2-1\" data-name=\"window hours input\" readonly=\"\" value=\"72\"/>\n                            </label>\n                            <label class=\"text-[11px] text-[#a8b2bf]\" data-kid=\"1-1-2-4-1-2-1-3\" data-name=\"min inr setting container\">\n                                Minimum INR\n                                <input class=\"mt-1 h-9 w-full border border-[#263342] bg-[#0b1118] px-2.5 font-mono text-[12px] text-[#d7dee8] outline-none\" data-kid=\"1-1-2-4-1-2-1-3-1\" data-name=\"min inr input\" readonly=\"\" value=\"5,000\"/>\n                            </label>\n                            <label class=\"text-[11px] text-[#a8b2bf]\" data-kid=\"1-1-2-4-1-2-1-4\" data-name=\"max outflows setting container\">\n                                Max outflows\n                                <input class=\"mt-1 h-9 w-full border border-[#263342] bg-[#0b1118] px-2.5 font-mono text-[12px] text-[#d7dee8] outline-none\" data-kid=\"1-1-2-4-1-2-1-4-1\" data-name=\"max outflows input\" readonly=\"\" value=\"10\"/>\n                            </label>\n                            <label class=\"text-[11px] text-[#a8b2bf]\" data-kid=\"1-1-2-4-1-2-1-5\" data-name=\"max nodes setting container\">\n                                Max nodes\n                                <input class=\"mt-1 h-9 w-full border border-[#263342] bg-[#0b1118] px-2.5 font-mono text-[12px] text-[#d7dee8] outline-none\" data-kid=\"1-1-2-4-1-2-1-5-1\" data-name=\"max nodes input\" readonly=\"\" value=\"100\"/>\n                            </label>\n                            <label class=\"text-[11px] 