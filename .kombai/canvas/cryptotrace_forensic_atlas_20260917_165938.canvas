ceipt header\">\n                                <div class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#8895a7]\" data-kid=\"1-1-2-4-1-2-4-1-1\" data-name=\"trace receipt title\">\n                                    Trace receipt\n                                </div>\n                                <span class=\"font-mono text-[10px] text-[#f5b84b]\" data-kid=\"1-1-2-4-1-2-4-1-2\" data-name=\"trace coverage status\">\n                                    PARTIAL\n                                </span>\n                            </div>\n                            <dl class=\"mt-2 space-y-2 text-[11px]\" data-kid=\"1-1-2-4-1-2-4-2\" data-name=\"receipt metrics list\">\n                                <div class=\"flex justify-between gap-3\" data-kid=\"1-1-2-4-1-2-4-2-1\" data-name=\"root wallet item\">\n                                    <dt class=\"text-[#8895a7]\" data-kid=\"1-1-2-4-1-2-4-2-1-1\" data-name=\"root wallet label\">\n                                        Root wallet\n                                    </dt>\n                                    <dd class=\"font-mono text-[#d7dee8]\" data-kid=\"1-1-2-4-1-2-4-2-1-2\" data-name=\"root wallet address\">\n                                        0x7F31...A92C\n                                    </dd>\n                                </div>\n                                <div class=\"flex justify-between\" data-kid=\"1-1-2-4-1-2-4-2-2\" data-name=\"nodes edges item\">\n                                    <dt class=\"text-[#8895a7]\" data-kid=\"1-1-2-4-1-2-4-2-2-1\" data-name=\"nodes edges label\">\n                                        Nodes / edges\n                                    </dt>\n                                    <dd class=\"font-mono text-[#d7dee8]\" data-kid=\"1-1-2-4-1-2-4-2-2-2\" data-name=\"nodes edges value\">\n                                        17 / 31\n                                    </dd>\n                                </div>\n                                <div class=\"flex justify-between\" data-kid=\"1-1-2-4-1-2-4-2-3\" data-name=\"depth reached item\">\n                                    <dt class=\"text-[#8895a7]\" data-kid=\"1-1-2-4-1-2-4-2-3-1\" data-name=\"depth reached label\">\n                                        Depth reached\n                                    </dt>\n                                    <dd class=\"font-mono text-[#d7dee8]\" data-kid=\"1-1-2-4-1-2-4-2-3-2\" data-name=\"depth reached value\">\n                                        4 hops\n                                    </dd>\n                                </div>\n                                <div class=\"flex justify-between\" data-kid=\"1-1-2-4-1-2-4-2-4\" data-name=\"termination reason item\">\n                                    <dt class=\"text-[#8895a7]\" data-kid=\"1-1-2-4-1-2-4-2-4-1\" data-name=\"termination reason label\">\n                                        Termination\n                                    </dt>\n                                    <dd class=\"font-mono text-[#d7dee8]\" data-kid=\"1-1-2-4-1-2-4-2-4-2\" data-name=\"termination reason value\">\n                                        LOW_VALUE\n                                    </dd>\n                                </div>\n                            </dl>\n                            <div class=\"mt-3 border-l-2 border-[#f5b84b] bg-[#171407] px-3 py-2 text-[11px] leading-4 text-[#cdbf90]\" data-kid=\"1-1-2-4-1-2-4-3\" data-name=\"limits disclaimer text\">\n                                Applied limits: 5 hops · 72h · ₹5,000 floor · 10 outflows · 100 nodes.\n                            </div>\n                        </div>\n                    </div>\n                </aside>\n                <section class=\"min-w-0 border border-[#263342] bg-[#121922]\" data-kid=\"1-1-2-4-2\" data-name=\"atlas graph container\">\n                    <div class=\"flex items-center justify-between gap-3 border-b border-[#263342] px-4 py-3\" data-kid=\"1-1-2-4-2-1\" data-name=\"atlas header\">\n                        <div data-kid=\"1-1-2-4-2-1-1\" data-name=\"atlas header title group\">\n                            <div class=\"flex items-center gap-3\" data-kid=\"1-1-2-4-2-1-1-1\" data-name=\"atlas title container\">\n                                <h2 class=\"m-0 text-[15px] font-bold text-[#f2f6fb]\" data-kid=\"1-1-2-4-2-1-1-1-1\" data-name=\"atlas title\">\n                                    Fund-flow atlas\n                                </h2>\n                                <span class=\"font-mono text-[10px] text-[#8895a7]\" data-kid=\"1-1-2-4-2-1-1-1-2\" data-name=\"atlas metrics\">\n                                    12 visible edges · ₹7,20,500 traced\n                                </span>\n                            </div>\n                            <p class=\"m-1 0 0 text-[11px] text-[#8895a7]\" data-kid=\"1-1-2-4-2-1-1-2\" data-name=\"atlas description\">\n                                Movement is shown by hop distance from the reported wallet. Selection stays calm until investigator action.\n                            </p>\n                        </div>\n                        <div class=\"flex items-center gap-1\" data-kid=\"1-1-2-4-2-1-2\" data-name=\"atlas view controls\">\n                            <button class=\"min-h-8 border border-[#263342] bg-[#0b1118] px-2.5 text-[11px] text-[#a8cfff]\" data-kid=\"1-1-2-4-2-1-2-1\" data-name=\"zoom out button\">\n                                Zoom −\n                            </button>\n                            <button class=\"min-h-8 border border-[#315c8f] bg-[#102131] px-2.5 text-[11px] text-[#d7dee8]\" data-kid=\"1-1-2-4-2-1-2-2\" data-name=\"reset view button\">\n                                Reset view\n                            </button>\n                            <button class=\"min-h-8 border border-[#263342] bg-[#0b1118] px-2.5 text-[11px] text-[#a8cfff]\" data-kid=\"1-1-2-4-2-1-2-3\" data-name=\"zoom in button\">\n                                Zoom +\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"flex items-center justify-between border-b border-[#263342] bg-[#0e151d] px-4 py-2 text-[10px]\" data-kid=\"1-1-2-4-2-2\" data-name=\"atlas legend container\">\n                        <div class=\"flex items-center gap-4\" data-kid=\"1-1-2-4-2-2-1\" data-name=\"legend items list\">\n                            <span class=\"flex items-center gap-1.5\" data-kid=\"1-1-2-4-2-2-1-1\" data-name=\"confirmed transfer legend\">\n                                <i class=\"h-2 w-6 bg-[#5da9ff]\" data-kid=\"1-1-2-4-2-2-1-1-1\" data-name=\"transfer indicator bar\">\n                                </i>\n                                <span class=\"text-[#a8b2bf]\" data-kid=\"1-1-2-4-2-2-1-1-2\" data-name=\"transfer label\">\n                                    Confirmed transfer\n                                </span>\n                            </span>\n                            <span class=\"flex items-center gap-1.5\" data-kid=\"1-1-2-4-2-2-1-2\" data-name=\"heuristic relationship legend\">\n                                <i class=\"w-6 border-t-2 border-dashed border-[#f5b84b]\" data-kid=\"1-1-2-4-2-2-1-2-1\" data-name=\"heuristic indicator dashed line\">\n                                </i>\n                                <span class=\"text-[#a8b2bf]\" data-kid=\"1-1-2-4-2-2-1-2-2\" data-name=\"heuristic label\">\n                                    HEURISTIC\n                                </span>\n                            </span>\n                            <span class=\"text-[#8895a7]\" data-kid=\"1-1-2-4-2-2-1-3\" data-name=\"coverage scope text\">\n                                H0 root · H1–H4 downstream\n                            </span>\n                        </div>\n                        <span class=\"font-mono text-[#f5b84b]\" data-kid=\"1-1-2-4-2-2-2\" data-name=\