      "html": "<style>\n  :root{\n    --bg:#08090B;\n    --sidebar:#0B0C0E;\n    --elev-1:#121417;\n    --elev-2:#181A1E;\n    --stage:#050506;\n    --line:rgba(255,255,255,.075);\n    --line-strong:rgba(255,255,255,.14);\n    --text:#F2F3F4;\n    --text-2:#A6ABB2;\n    --text-3:#767C85;\n    --accent:#37B394;\n    --accent-2:#6FD7BC;\n    --accent-deep:#1C8A72;\n    --accent-tint:rgba(55,179,148,.13);\n    --gold:#E8B24B;\n    --ember:#DE7040;\n    --r-sm:10px; --r-md:14px; --r-lg:20px; --r-pill:999px;\n    --shadow:0 24px 60px -30px rgba(0,0,0,.85), 0 2px 8px rgba(0,0,0,.35);\n    --ease:cubic-bezier(0.16,1,0.3,1);\n    --font:-apple-system, BlinkMacSystemFont, \"Segoe UI\", Inter, Roboto, \"Helvetica Neue\", Arial, sans-serif;\n  }\n  *,*::before,*::after{box-sizing:border-box;}\n  html,body{margin:0;padding:0;}\n  body{\n    background:var(--bg);color:var(--text);\n    font-family:var(--font);font-size:15px;line-height:1.45;\n    -webkit-font-smoothing:antialiased;\n  }\n  button{font:inherit;color:inherit;background:none;border:0;cursor:pointer;}\n  a{color:inherit;text-decoration:none;}\n  img,svg{display:block;max-width:100%;}\n  :focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:8px;}\n  ::selection{background:rgba(55,179,148,.28);}\n\n  .app{display:flex;min-height:100vh;}\n\n  /* ---------------- sidebar ---------------- */\n  .sidebar{\n    width:240px;flex:none;\n    background:var(--sidebar);\n    border-right:1px solid var(--line);\n    display:flex;flex-direction:column;\n    padding:20px 16px 18px;\n  }\n  .logo{\n    width:40px;height:40px;border-radius:12px;\n    background:linear-gradient(145deg,var(--accent),var(--accent-deep));\n    display:grid;place-items:center;margin:0 0 30px 8px;\n    box-shadow:0 8px 20px -10px rgba(55,179,148,.9);\n    transition:transform .3s var(--ease);\n  }\n  .logo:hover{transform:translateY(-1px) rotate(-3deg);}\n\n  .navlist{display:flex;flex-direction:column;gap:2px;}\n  .navlist a{\n    display:flex;align-items:center;gap:16px;\n    height:46px;padding:0 20px;border-radius:var(--r-pill);\n    font-size:16px;font-weight:550;letter-spacing:-.012em;color:var(--text);\n    transition:background-color .25s var(--ease), color .25s var(--ease);\n  }\n  .navlist a:hover{background:rgba(255,255,255,.045);}\n  .navlist a svg{flex:none;color:var(--text-2);transition:color .25s var(--ease);}\n  .navlist a:hover svg{color:var(--text);}\n  .navlist a.is-active{background:var(--accent-tint);color:var(--accent-2);}\n  .navlist a.is-active svg{color:var(--accent-2);}\n\n  .sidebar hr{\n    border:0;border-top:1px solid var(--line);\n    margin:22px -16px 22px;\n  }\n  .actionlist{display:flex;flex-direction:column;gap:6px;}\n  .actionlist a{\n    display:flex;align-items:center;gap:16px;\n    height:46px;padding:0 12px;border-radius:var(--r-pill);\n    font-size:16px;font-weight:550;letter-spacing:-.012em;\n    transition:background-color .25s var(--ease);\n  }\n  .actionlist a:hover{background:rgba(255,255,255,.045);}\n  .actionlist .dot{\n    width:34px;height:34px;flex:none;border-radius:var(--r-pill);\n    border:1px solid var(--line-strong);\n    display:grid;place-items:center;color:var(--text);\n    transition:border-color .25s var(--ease), background-color .25s var(--ease);\n  }\n  .actionlist a:hover .dot{border-color:rgba(255,255,255,.3);background:rgba(255,255,255,.04);}\n\n  .collapse{\n    margin-top:auto;align-self:flex-end;\n    width:36px;height:36px;border-radius:var(--r-pill);\n    display:grid;place-items:center;color:var(--text-3);\n    transition:color .25s var(--ease), background-color .25s var(--ease);\n  }\n  .collapse:hover{color:var(--text);background:rgba(255,255,255,.05);}\n\n  /* ---------------- main ---------------- */\n  .main{flex:1;min-width:0;display:flex;flex-direction:column;}\n\n  .topbar{\n    height:79px;flex:none;\n    display:flex;align-items:center;justify-content:flex-end;gap:12px;\n    padding:0 32px;\n    border-bottom:1px solid var(--line);\n  }\n  .search{\n    position:relative;width:560px;max-width:100%;\n  }\n  .search svg{\n    position:absolute;left:18px;top:50%;transform:translateY(-50%);\n    color:var(--text-3);pointer-events:none;\n  }\n  .search input{\n    width:100%;height:44px;\n    padding:0 18px 0 50px;\n    border-radius:var(--r-pill);\n    border:1px solid transparent;\n    background:var(--elev-2);\n    color:var(--text);font:inherit;font-size:15px;\n    transition:border-color .25s var(--ease), background-color .25s var(--ease);\n  }\n  .search input::placeholder{color:var(--text-3);}\n  .search input:hover{background:#1D2025;}\n  .search input:focus{outline:none;border-color:rgba(55,179,148,.55);background:#1D2025;}\n\n  .roundbtn{\n    width:40px;height:40px;flex:none;border-radius:var(--r-pill);\n    background:var(--elev-2);\n    display:grid;place-items:center;color:var(--text-2);\n    transition:background-color .25s var(--ease), color .25s var(--ease), transform .25s var(--ease);\n  }\n  .roundbtn:hover{background:#23262B;color:var(--text);}\n  .roundbtn:active{transform:scale(.94);}\n\n  .tabs{\n    display:flex;align-items:flex-end;gap:6px;\n    padding:0 32px;\n    border-bottom:1px solid var(--line);\n  }\n  .tabs a{\n    position:relative;\n    padding:0 12px 16px;\n    font-size:17px;font-weight:600;letter-spacing:-.015em;color:var(--text-2);\n    transition:color .25s var(--ease);\n  }\n  .tabs a:hover{color:var(--text);}\n  .tabs a.is-active{color:var(--accent-2);}\n  .tabs a.is-active::after{\n    content:\"\";position:absolute;left:8px;right:8px;bottom:-1px;height:2px;\n    background:var(--accent-2);border-radius:2px 2px 0 0;\n  }\n\n  .content{padding:28px 32px 44px;display:flex;flex-direction:column;gap:26px;}\n\n  /* ---------------- hero ---------------- */\n  .hero{\n    display:grid;grid-template-columns:1.05fr 1fr;\n    background:var(--elev-1);\n    border:1px solid var(--line);\n    border-radius:var(--r-lg);\n    overflow:hidden;\n    box-shadow:var(--shadow), inset 0 1px 0 rgba(255,255,255,.05);\n  }\n  .hero-copy{padding:40px 44px 40px;display:flex;flex-direction:column;}\n  .tag{\n    align-self:flex-start;\n    padding:1px;border-radius:var(--r-pill);\n    background:linear-gradient(105deg,var(--accent),var(--gold) 55%,var(--ember));\n  }\n  .tag span{\n    display:block;padding:7px 16px;border-radius:var(--r-pill);\n    background:var(--elev-1);\n    font-size:11.5px;font-weight:700;letter-spacing:.11em;text-transform:uppercase;\n    color:var(--text);\n  }\n  .creator{display:flex;align-items:center;gap:12px;margin:28px 0 20px;}\n  .creator .thumb{\n    width:38px;height:38px;border-radius:9px;overflow:hidden;flex:none;\n    background:#1B1D22;border:1px solid var(--line-strong);\n  }\n  .creator .name{\n    font-size:12.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--text);\n  }\n  .hero h1{\n    margin:0;\n    font-size:50px;line-height:1.07;font-weight:600;letter-spacing:-.032em;\n    max-width:11ch;\n  }\n  .hero p{\n    margin:20px 0 0;\n    font-size:16px;line-height:1.55;color:var(--text-2);\n    max-width:46ch;\n  }\n  .mint{\n    margin-top:auto;padding-top:34px;\n  }\n  .mint button{\n    width:100%;height:58px;border-radius:var(--r-pill);\n    background:linear-gradient(95deg,var(--accent-deep),var(--accent) 45%,var(--accent-2));\n    color:#04160F;font-size:16.5px;font-weight:700;letter-spacing:-.01em;\n    box-shadow:0 18px 36px -22px rgba(55,179,148,.95);\n    transition:transform .3s var(--ease), box-shadow .3s var(--ease), filter .3s var(--ease);\n  }\n  .mint button:hover{transform:translateY(-2px);filter:saturate(1.06) brightness(1.03);box-shadow:0 24px 44px -22px rgba(55,179,148,1);}\n  .mint button:active{transform:translateY(0);}\n\n  .hero-art{\n    position:relative;\n    background:var(--stage);\n    border-left:1px solid var(--line);\n    display:grid;place-items:center;\n    padding:34px;\n    min-height:454px;\n  }\n  .hero-art::after{\n    content:\"\";position:absolute;inset:0;pointer-events:none;\n    background:radial-gradient(58% 46% at 50% 62%, rgba(232,178,75,.16), transparent 70%);\n  }\n  .pixart{width:min(268px,72%);height:auto;position:relative;z-index:1;}\n  .sharebtn{\n    position:absolute;top:20px;right:20px;z-index:2;\n    width:38px;height:38px;border-radius:var(--r-pill);\n    background:rgba(28,30,34,.82);\n    border:1px solid var(--line-strong);\n    display:grid;place-items:center;color:var(--text);\n    -webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);\n    transition:background-color .25s var(--ease), transform .25s var(--ease);\n  }\n  .sharebtn:hover{background:rgba(48,52,58,.92);transform:translateY(-1px);}\n\n  /* ---------------- points bar ---------------- */\n  .points{\n    padding:1.4px;border-radius:18px;\n    background:linear-gradient(100deg,var(--ember),var(--gold) 32%,var(--accent) 66%,#4F9FD1);\n    box-shadow:0 20px 44px -34px rgba(55,179,148,.8);\n  }\n  .points-inner{\n    display:flex;align-items:center;justify-content:space-between;gap:24px;\n    background:var(--elev-1);\n    border-radius:16.6px;\n    padding:18px 20px;\n    box-shadow:inset 0 1px 0 rgba(255,255,255,.05);\n  }\n  .who{display:flex;align-items:center;gap:16px;min-width:0;}\n  .who .pfp{\n    width:46px;height:46px;flex:none;border-radius:var(--r-pill);overflow:hidden;\n    background:#22252A;border:1px solid var(--line-strong);\n  }\n  .who .pfp img{width:100%;height:100%;object-fit:cover;}\n  .who .handle{\n    font-size:21px;font-weight:650;letter-spacing:-.022em;\n    overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\n  }\n  .chips{display:flex;gap:14px;flex:none;}\n  .chip{\n    display:flex;align-items:center;gap:13px;\n    background:var(--elev-2);border-radius:var(--r-md);\n    padding:12px 26px 12px 14px;min-width:180px;\n  }\n  .chip .badge{\n    width:34px;height:34px;flex:none;border-radius:var(--r-pill);\n    display:grid;place-items:center;color:#08090B;\n  }\n  .chip .badge.b1{background:linear-gradient(140deg,var(--ember),var(--gold));}\n  .chip .badge.b2{background:linear-gradient(140deg,var(--accent-2),var(--accent-deep));}\n  .chip .stack{display:flex;flex-direction:column;min-width:0;}\n  .chip .val{font-size:16px;font-weight:700;letter-spacing:-.02em;font-variant-numeric:tabular-nums;line-height:1.25;}\n  .chip .lbl{font-size:11px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;color:#8E949C;line-height:1.3;}\n\n  /* ---------------- trending ---------------- */\n  .sec-head{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-top:8px;}\n  .sec-head h2{margin:0;font-size:29px;font-weight:650;letter-spacing:-.028em;}\n  .sec-head p{margin:8px 0 0;font-size:15.5px;color:var(--text-2);}\n  .sec-head a{\n    font-size:15px;font-weight:600;color:var(--accent-2);\n    transition:opacity .25s var(--ease);\n  }\n  .sec-head a:hover{opacity:.75;}\n\n  .cards{\n    display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:22px;\n  }\n  .card{\n    background:var(--elev-1);border:1px solid var(--line);\n    border-radius:var(--r-lg);overflow:hidden;\n    transition:transform .35s var(--ease), border-color .35s var(--ease), box-shadow .35s var(--ease);\n  }\n  .card:hover{transform:translateY(-3px);border-color:var(--line-strong);box-shadow:var(--shadow);}\n  .thumb{\n    position:relative;aspect-ratio:16/11;overflow:hidden;\n  }\n  .thumb svg.scene{width:100%;height:100%;display:block;}\n  .card .sharebtn{top:14px;right:14px;width:34px;height:34px;}\n  .card-body{padding:15px 18px 18px;}\n  .card-body h3{margin:0;font-size:15.5px;font-weight:600;letter-spacing:-.015em;}\n  .card-body span{display:block;margin-top:5px;font-size:13.5px;color:var(--text-3);}\n\n  @media (max-width:1180px){\n    .cards{grid-template-columns:repeat(2,1fr);}\n    .hero{grid-template-columns:1fr;}\n    .hero-art{border-left:0;border-top:1px solid var(--line);min-height:380px;}\n  }\n  @media (max-width:820px){\n    .sidebar{display:none;}\n    .search{width:100%;}\n    .points-inner{flex-wrap:wrap;}\n    .cards{grid-template-columns:1fr;}\n    .hero h1{font-size:38px;}\n  }\n</style>\n\n<div class=\"app\">\n\n  <aside class=\"sidebar\">\n    <a class=\"logo\" href=\"#\" aria-label=\"Kestrel home\">\n      <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n        <path d=\"M4.5 19.5 12 4l7.5 15.5-7.5-4.2-7.5 4.2Z\" fill=\"#05130F\"/>\n      </svg>\n    </a>\n\n    <nav class=\"navlist\" aria-label=\"Primary\">\n      <a href=\"#\" class=\"is-active\">\n        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 10.6 12 4l8 6.6V19a1.4 1.4 0 0 1-1.4 1.4H5.4A1.4 1.4 0 0 1 4 19v-8.4Z\" fill=\"currentColor\"/></svg>\n        Home\n      </a>\n      <a href=\"#\">\n        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"8.2\" stroke=\"currentColor\" stroke-width=\"1.7\"/><path d=\"M12 3.8V12l5.9 5.7\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/></svg>\n        Portfolio\n      </a>\n      <a href=\"#\">\n        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><ellipse cx=\"12\" cy=\"12\" rx=\"8.2\" ry=\"4.6\" transform=\"rotate(-28 12 12)\" stroke=\"currentColor\" stroke-width=\"1.7\"/><circle cx=\"12\" cy=\"12\" r=\"2.1\" fill=\"currentColor\"/></svg>\n        Apps\n      </a>\n    </nav>\n\n    <hr />\n\n    <nav class=\"actionlist\" aria-label=\"Wallet actions\">\n      <a href=\"#\"><span class=\"dot\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg></span>Buy</a>\n      <a href=\"#\"><span class=\"dot\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" aria-