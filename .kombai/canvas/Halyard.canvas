      "html": "<style>\n  :root{\n    --font-ui: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Inter, Roboto, \"Helvetica Neue\", Arial, sans-serif;\n    --font-mono: ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, monospace;\n\n    /* off-black neutral family (cool-neutral, single family) */\n    --bg:      #0c1311;\n    --rail:    #0e1613;\n    --panel:   #141c19;\n    --panel-2: #192420;\n    --line:    rgba(255,255,255,.075);\n    --line-2:  rgba(255,255,255,.045);\n\n    --text:    #e6eeeb;\n    --text-2:  #98a7a2;\n    --text-3:  #6a7974;\n\n    /* one restrained accent: warm amber */\n    --accent:      #d99b4f;\n    --accent-soft: rgba(217,155,79,.14);\n    --accent-line: rgba(217,155,79,.34);\n\n    --s-1:4px; --s-2:8px; --s-3:12px; --s-4:16px;\n    --s-5:20px; --s-6:24px; --s-7:32px; --s-8:44px; --s-9:64px;\n\n    --r-sm:6px; --r-md:9px; --r-lg:12px;\n    --rail-w:72px;\n\n    --shadow: 0 1px 2px rgba(0,0,0,.4), 0 22px 46px -26px rgba(0,0,0,.9);\n    --ease: cubic-bezier(0.16, 1, 0.3, 1);\n  }\n\n  *,*::before,*::after{ box-sizing:border-box; }\n  html,body{ margin:0; padding:0; }\n  body{\n    background:var(--bg);\n    color:var(--text);\n    font-family:var(--font-ui);\n    font-size:15px; line-height:1.5;\n    -webkit-font-smoothing:antialiased;\n  }\n  svg{ display:block; }\n  button{ font:inherit; color:inherit; background:none; border:0; }\n  a{ color:inherit; text-decoration:none; }\n  ::selection{ background:rgba(217,155,79,.26); }\n  :focus-visible{ outline:2px solid var(--accent); outline-offset:2px; border-radius:4px; }\n  @media (prefers-reduced-motion:reduce){ *{ transition-duration:.01ms !important; } }\n\n  /* ---------- top bar ---------- */\n  .topbar{\n    display:flex; align-items:stretch;\n    height:60px;\n    background:var(--rail);\n    border-bottom:1px solid var(--line);\n    position:sticky; top:0; z-index:30;\n  }\n  .logo-cell{\n    width:var(--rail-w); flex:none;\n    display:grid; place-items:center;\n    border-right:1px solid var(--line);\n  }\n  .logo{\n    width:26px; height:26px; color:var(--accent);\n    transition:transform .4s var(--ease);\n  }\n  .logo-cell:hover .logo{ transform:translateY(-1px) rotate(-4deg); }\n  .crumbs{\n    display:flex; align-items:center; gap:var(--s-4);\n    padding:0 var(--s-5);\n    min-width:0;\n  }\n  .crumbs .org{\n    font-size:13.5px; color:var(--text-2); letter-spacing:-.004em;\n    white-space:nowrap; overflow:hidden; text-overflow:ellipsis;\n    transition:color .2s var(--ease);\n  }\n  .crumbs .org:hover{ color:var(--text); }\n  .crumbs .slash{ color:var(--text-3); }\n  .crumbs .proj{ font-size:13.5px; font-weight:600; letter-spacing:-.006em; white-space:nowrap; }\n\n  .topbar-right{\n    margin-left:auto; display:flex; align-items:center; gap:var(--s-2);\n    padding:0 var(--s-5) 0 var(--s-4);\n  }\n  .ghost{\n    display:inline-flex; align-items:center; gap:8px;\n    border:1px solid var(--line);\n    background:var(--panel);\n    border-radius:var(--r-sm);\n    padding:6px 11px;\n    font-size:13px; font-weight:520; color:var(--text-2);\n    cursor:pointer; white-space:nowrap;\n    transition:background-color .22s var(--ease), color .22s var(--ease), border-color .22s var(--ease), transform .35s var(--ease);\n  }\n  .ghost:hover{ background:var(--panel-2); color:var(--text); border-color:rgba(255,255,255,.14); }\n  .ghost:active{ transform:translateY(1px); }\n  .ghost.square{ padding:6px; }\n\n  /* ---------- shell ---------- */\n  .shell{ display:flex; align-items:stretch; min-height:calc(100vh - 60px); }\n\n  .railnav{\n    width:var(--rail-w); flex:none;\n    background:var(--rail);\n    border-right:1px solid var(--line);\n    display:flex; flex-direction:column; align-items:center;\n    padding:var(--s-4) 0 var(--s-5);\n    gap:var(--s-1);\n  }\n  .railnav a{\n    width:38px; height:38px; border-radius:var(--r-sm);\n    display:grid; place-items:center;\n    color:var(--text-3);\n    transition:color .2s var(--ease), background-color .2s var(--ease);\n  }\n  .railnav a:hover{ color:var(--text); background:var(--panel-2); }\n  .railnav a.is-active{ color:var(--text); background:var(--panel-2); box-shadow:inset 0 0 0 1px var(--line); }\n  .rail-sep{ width:34px; height:1px; background:var(--line); margin:var(--s-4) 0; }\n  .rail-bottom{ margin-top:auto; display:flex; flex-direction:column; align-items:center; gap:var(--s-1); }\n\n  .main{ flex:1 1 auto; min-width:0; padding:var(--s-9) clamp(24px, 5vw, 76px) 96px; }\n  .page-title{\n    margin:0 0 var(--s-9);\n    font-size:40px; font-weight:420; letter-spacing:-.028em; line-height:1.1;\n  }\n\n  .range{\n    display:flex; align-items:center; gap:var(--s-4);\n    margin-bottom:var(--s-6);\n    flex-wrap:wrap;\n  }\n  .select{\n    display:inline-flex; align-items:center; gap:10px;\n    background:var(--panel);\n    border:1px solid var(--line);\n    border-radius:var(--r-sm);\n    padding:7px 12px;\n    font-size:13.5px; font-weight:520; color:var(--text);\n    cursor:pointer;\n    transition:background-color .22s var(--ease), border-color .22s var(--ease);\n  }\n  .select:hover{ background:var(--panel-2); border-color:rgba(255,255,255,.14); }\n  .select svg{ color:var(--text-3); }\n  .range p{ margin:0; font-size:13.5px; color:var(--text-3); }\n\n  /* ---------- metric cards ---------- */\n  .metrics{\n    display:grid;\n    grid-template-columns:repeat(4, minmax(0,1fr));\n    gap:var(--s-8);\n  }\n  .metric{\n    background:linear-gradient(180deg, #16211d 0%, #131b18 60%);\n    border:1px solid var(--line);\n    border-radius:var(--r-lg);\n    padding:var(--s-6) var(--s-6) var(--s-5);\n    display:flex; flex-direction:column;\n    min-height:300px;\n    box-shadow:var(--shadow), inset 0 1px 0 rgba(255,255,255,.045);\n    transition:border-color .3s var(--ease), transform .4s var(--ease);\n  }\n  .metric:hover{ border-color:rgba(255,255,255,.14); transform:translateY(-2px); }\n  .metric-head{ display:flex; align-items:center; gap:var(--s-3); }\n  .metric-icon{\n    width:28px; height:28px; flex:none;\n    border-radius:var(--r-sm);\n    background:var(--panel-2);\n    border:1px solid var(--line);\n    display:grid; place-items:center;\n    color:var(--text-2);\n  }\n  .metric-head h2{\n    margin:0; font-size:18px; font-weight:480; letter-spacing:-.018em;\n  }\n  .metric-label{\n    margin:var(--s-6) 0 0;\n    font-size:13.5px; color:var(--text-3); letter-spacing:-.002em;\n  }\n  .metric-value{\n    margin-top:var(--s-2);\n    font-size:27px; font-weight:420; letter-spacing:-.026em; line-height:1.15;\n    font-variant-numeric:tabular-nums;\n  }\n  .metric-value.is-zero{ color:var(--text-3); }\n\n  .chart{ margin-top:auto; }\n  .bars{\n    display:flex; align-items:flex-end; justify-content:space-between;\n    gap:3px;\n    height:132px;\n    padding-bottom:6px;\n    border-bottom:1px solid var(--line);\n  }\n  .bars span{\n    flex:1 1 auto; max-width:7px;\n    height:var(--h, 0%);\n    background:linear-gradient(180deg, var(--accent) 0%, #b87f3c 100%);\n    border-radius:1.5px 1.5px 0 0;\n    transition:opacity .3s var(--ease);\n  }\n  .metric:hover .bars span{ opacity:.92; }\n  .axis{\n    display:flex; justify-content:space-between;\n    margin-top:10px;\n    font-size:12px; color:var(--text-3);\n    font-variant-numeric:tabular-nums;\n  }\n\n  /* ---------- client libraries ---------- */\n  .libs-head{\n    margin:96px 0 var(--s-7);\n    font-size:21px; font-weight:460; letter-spacing:-.02em;\n  }\n  .libs{\n    display:grid;\n    grid-template-columns:repeat(3, minmax(0,1fr));\n    gap:var(--s-9) var(--s-8);\n    max-width:1180px;\n  }\n  .lib-top{ display:flex; align-items:center; gap:var(--s-3); flex-wrap:wrap; }\n  .lib-mark{\n    width:26px; height:26px; flex:none;\n    border-radius:var(--r-sm);\n    display:grid; place-items:center;\n    font-size:10.5px; font-weight:700; letter-spacing:.02em;\n    color:#0c1311;\n    box-shadow:inset 0 1px 0 rgba(255,255,255,.28);\n  }\n  .m1{ background:linear-gradient(158deg,#e8b96b,#c8863c); }\n  .m2{ background:linear-gradient(158deg,#8fb7c9,#5c8698); }\n  .m3{ background:linear-gradient(158deg,#a9bd8c,#728a58); }\n  .m4{ background:linear-gradient(158deg,#c9a3b6,#94687f); }\n  .m5{ background:linear-gradient(158deg,#a0bab0,#6b847b); }\n  .m6{ background:linear-gradient(158deg,#8f9ec4,#5f6d92); }\n  .lib-name{ font-size:19px; font-weight:440; letter-spacing:-.018em; }\n  .tag{\n    display:inline-flex; align-items:center;\n    border:1px solid var(--accent-line);\n    background:var(--accent-soft);\n    color:var(--accent);\n    border-radius:999px;\n    padding:2px 10px;\n    font-size:12px; font-weight:520; letter-spacing:-.002em;\n  }\n  .lib-actions{ display:flex; gap:var(--s-2); margin-top:var(--s-4); flex-wrap:wrap; }\n\n  @media (max-width:1240px){\n    .metrics{ grid-template-columns:repeat(2, minmax(0,1fr)); gap:var(--s-6); }\n    .libs{ grid-template-columns:repeat(2, minmax(0,1fr)); gap:var(--s-8) var(--s-7); }\n  }\n  @media (max-width:820px){\n    .main{ padding:var(--s-7) var(--s-5) 64px; }\n    .page-title{ font-size:32px; margin-bottom:var(--s-7); }\n    .libs-head{ margin-top:64px; }\n    .metrics{ grid-template-columns:minmax(0,1fr); }\n    .libs{ grid-template-columns:minmax(0,1fr); }\n    .railnav{ display:none; }\n    .logo-cell{ width:56px; }\n    .topbar-right .ghost .lbl{ display:none; }\n  }\n</style>\n\n\n<header class=\"topbar\">\n  <a class=\"logo-cell\" href=\"#\" aria-label=\"Halyard home\">\n    <svg class=\"logo\" viewBox=\"0 0 26 26\" fill=\"none\" aria-hidden=\"true\">\n      <path d=\"M13 2.2 5.4 14.4h5.7L9.6 23.8 20.4 10.6h-6.2l1.9-8.4Z\" fill=\"currentColor\"/>\n    </svg>\n  </a>\n  <nav class=\"crumbs\" aria-label=\"Breadcrumb\">\n    <a class=\"org\" href=\"#\">Kestrel Labs</a>\n    <span class=\"slash\" aria-hidden=\"true\">/</span>\n    <span class=\"proj\">Coastline Rewrite</span>\n  </nav>\n  <div class=\"topbar-right\">\n    <button class=\"ghost\" type=\"button\">\n      <svg width=\"15\" height=\"15\" viewBox=\"0 0 18 18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"><circle cx=\"9\" cy=\"9\" r=\"6.8\"/><path d=\"M7.3 7.2a1.8 1.8 0 1 1 2.4 1.8c-.5.3-.7.7-.7 1.2\"/><path d=\"M9 12.8h.01\"/></svg>\n      <span class=\"lbl\">Help</span>\n    </button>\n    <button class=\"ghost\" type=\"button\">\n      <svg width=\"15\" height=\"15\" viewBox=\"0 0 18 18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15.4 9.4a5.9 5.9 0 0 1-6.4 5.9L4.5 16.2l.7-3.4A5.9 5.9 0 1 1 15.4 9.4Z\"/></svg>\n      <span class=\"lbl\">Feedback</span>\n    </button>\n    <button class=\"ghost square\" type=\"button\" aria-label=\"Notifications\">\n      <svg width=\"16\" height=\"16\" viewBox=\"0 0 18 18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4.5 7.6a4.5 4.5 0 0 1 9 0c0 2.9.9 4.2 1.5 4.8H3c.6-.6 1.5-1.9 1.5-4.8Z\"/><path d=\"M7.4 14.4a1.7 1.7 0 0 0 3.2 0\"/></svg>\n    </button>\n  </div>\n</header>\n\n<div class=\"shell\">\n  <nav class=\"railnav\" aria-label=\"Project sections\">\n    <a href=\"#\" class=\"is-active\" aria-current=\"page\" aria-label=\"Project home\">\n      <svg width=\"19\" height=\"19\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3.2 8.6 10 3.2l6.8 5.4v7a1.4 1.4 0 0 1-1.4 1.4H4.6a1.4 1.4 0 0 1-1.4-1.4Z\"/><path d=\"M7.8 17V11h4.4v6\"/></svg>\n    </a>\n    <a href=\"#\" aria-label=\"Tables\">\n      <svg width=\"19\" height=\"19\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"3.6\" width=\"14\" height=\"12.8\" rx=\"2\"/><path d=\"M3 7.8h14M8.2 7.8v8.6\"/></svg>\n    </a>\n    <a href=\"#\" aria-label=\"Query console\">\n      <svg width=\"19\" height=\"19\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"3.6\" width=\"14\" height=\"12.8\" rx=\"2\"/><path d=\"M6.4 8.2 8.6 10l-2.2 1.8M10.6 12.2h3\"/></svg>\n    </a>\n    <span class=\"rail-sep\" aria-hidden=\"true\"></span>\n    <a href=\"#\" aria-label=\"Database\">\n      <svg width=\"19\" height=\"19\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><ellipse cx=\"10\" cy=\"5.4\" rx=\"6.2\" ry=\"2.4\"/><path d=\"M3.8 5.4v9.2c0 1.3 2.8 2.4 6.2 2.4s6.2-1.1 6.2-2.4V5.4\"/><path d=\"M3.8 10c0 1.3 2.8 2.4 6.2 2.4s6.2-1.1 6.2-2.4\"/></svg>\n    </a>\n    <a href=\"#\" aria-label=\"Auth\">\n      <svg width=\"19\" height=\"19\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"4.4\" y=\"8.6\" width=\"11.2\" height=\"8\" rx=\"2\"/><path d=\"M7 8.6V6.4a3 3 0 0 1 6 0v2.2\"/></svg>\n    </a>\n    <a href=\"#\" aria-label=\"Storage\">\n      <svg width=\"19\" height=\"19\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M2.8 6.2c0-1 .8-1.8 1.8-1.8h2.8l1.6 2h6.4c1 0 1.8.8 1.8 1.8v6.4c0 1-.8 1.8-1.8 1.8H4.6c-1 0-1.8-.8-1.8-1.8Z\"/></svg>\n    </a>\n    <a href=\"#\" aria-label=\"Edge workers\">\n      <svg width=\"19\" height=\"19\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"10\" cy=\"10\" r=\"7\"/><path d=\"M3.4 8.2h13.2M3.4 11.8h13.2\"/><path d=\"M10 3a11 11 0 0 0 0 14 11 11 0 0 0 0-14Z\"/></svg>\n    </a>\n    <span class=\"rail-sep\" aria-hidden=\"true\"></span>\n    <a href=\"#\" aria-label=\"Reports\">\n      <svg width=\"19\" height=\"19\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"curr